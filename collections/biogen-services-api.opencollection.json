{
  "opencollection": "1.0.0",
  "info": {
    "name": "Biogen Developer Keys Services API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Services",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Biogen List Services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://developer.biogen.com/api/services",
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves a list of available Biogen API services that can be accessed with valid credentials."
        }
      ]
    }
  ],
  "bundled": true
}